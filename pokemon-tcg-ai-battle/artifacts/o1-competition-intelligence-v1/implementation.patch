+class TestDeckObservation:
+    def _observation(self, **overrides: object) -> DeckObservation:
+        fields = dict(
+            schema_version=DECK_OBSERVATION_SCHEMA_VERSION,
+            episode_id="ep-1",
+            seat=0,
