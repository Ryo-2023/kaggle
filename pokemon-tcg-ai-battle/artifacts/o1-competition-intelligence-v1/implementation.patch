+        assert snapshot_a.snapshot_id == snapshot_b.snapshot_id
+        assert snapshot_a.snapshot_id.startswith("intelligence-snapshot-")
+
+    def test_changed_input_changes_hash(self) -> None:
+        fields = self._base_fields()
