+"""Tests for offline_reader.py + phase.py + replay_normalize.py.
+
+Fixtures are generated by calling the *real* Offline Training v1 collector
+(``run_collection(source="fixture", ...)``) exactly like
+``tests/test_offline_training_v1.py`` does, rather than hand-authoring JSON:
+the real writer's hashing/redaction/manifest logic is nontrivial to fake
+correctly by hand, and this proves the O1-2 reader against the actual
+on-disk contract, not a guess at it. This never touches the actual cabt
+engine (``source="fixture"`` drives a deterministic synthetic match runner).
+"""
+
+from __future__ import annotations
+
+import gzip
+import json
+from pathlib import Path
+
+import pytest
+
+from mage_ptcg.competition_intelligence.offline_reader import (
+    RuleBCRowError,
+    discover_offline_training_run,
+    iter_rule_bc_rows,
+    parse_rule_bc_row,
+)
+from mage_ptcg.competition_intelligence.phase import (
+    BOARD_DEVELOPMENT,
+    ENDGAME,
+    FIRST_MAJOR_EXCHANGE,
+    OPENING,
+    PRIZE_RACE,
+    SETUP,
+    UNKNOWN,
+    classify_phase,
+)
+from mage_ptcg.competition_intelligence.replay_normalize import normalize_rule_bc_jsonl
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+DECK_PATH = REPO_ROOT / "deck.csv"
+
+
+@pytest.fixture(scope="module")
+def collected_run(tmp_path_factory) -> Path:
+    from mage_ptcg.offline_training.collection import run_collection
+
+    root = tmp_path_factory.mktemp("o1-2-collection")
+    # Match the real production layout: the full Offline Training v1 CLI
+    # pipeline (Pipeline.phase_collect) passes output_root=<run>/"collection",
+    # not the run root directly -- run_collection() itself has no opinion on
+    # this extra directory layer, so a faithful "existing run artifact"
+    # fixture must add it explicitly.
+    run_collection(
+        source="fixture",
+        run_id="cabt",
+        games=6,
+        base_seed=1000,
+        output_root=root / "collection",
+        canonical_base_sha="a" * 40,
+        deck_path=DECK_PATH,
+        repository_root=REPO_ROOT,
+        validation_percent=20,
+        split_seed=0,
+        fixture_decisions_per_seat=4,
+        fixture_option_count=3,
+    )
+    return root
+
+
+@pytest.fixture(scope="module")
+def rule_bc_jsonl_path(collected_run: Path) -> Path:
+    return collected_run / "collection" / "cabt" / "private_dataset" / "rule-bc-v1.jsonl"
+
+
+class TestDiscoverOfflineTrainingRun:
+    def test_discovers_real_collection_output(self, collected_run: Path) -> None:
+        discovered = discover_offline_training_run(collected_run)
+        assert discovered.is_usable()
+        assert discovered.collection_jsonl_path is not None
+        assert discovered.collection_jsonl_path.name == "rule-bc-v1.jsonl"
+        assert discovered.collection_bindings_path is not None
+        assert discovered.dataset_manifest_path is None  # build-dataset phase not run in this fixture
+
+    def test_missing_run_root_reports_not_usable(self, tmp_path: Path) -> None:
+        discovered = discover_offline_training_run(tmp_path / "does-not-exist")
+        assert not discovered.is_usable()
+        assert discovered.collection_jsonl_path is None
+
+    def test_discovers_direct_collector_output_without_collection_subdir(self, tmp_path_factory) -> None:
+        from mage_ptcg.offline_training.collection import run_collection
+
+        root = tmp_path_factory.mktemp("o1-2-direct-collection")
+        run_collection(
+            source="fixture", run_id="cabt", games=2, base_seed=2000, output_root=root,
+            canonical_base_sha="a" * 40, deck_path=DECK_PATH, repository_root=REPO_ROOT,
+            validation_percent=20, split_seed=0, fixture_decisions_per_seat=2, fixture_option_count=3,
+        )
+        discovered = discover_offline_training_run(root)
+        assert discovered.is_usable()
