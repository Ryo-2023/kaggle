+
+        fingerprint = build_policy_fingerprint(list(normalized.decisions), agent_reference="rule")
+        for op in fingerprint.macro_distribution:
+            assert op in KNOWN_SEMANTIC_OPERATIONS or op == "OTHER"
+
+
+class TestJointFingerprint:
